# ===== Canva Connect API =====
# Get these from https://www.canva.com/developers/apps after creating an app
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# ===== Cookie signing =====
# Any long random string (50+ chars). Generate one at https://generate-secret.vercel.app/64
COOKIE_SECRET=change-me-to-a-very-long-random-string-min-32-chars

# ===== Anthropic Claude =====
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ===== Buffer (optional, for LinkedIn scheduling) =====
BUFFER_ACCESS_TOKEN=
BUFFER_CHANNEL_ID=

# ===== Public URL =====
# Set this AFTER your first Vercel deploy — it's the URL Vercel gives you
# Example: https://nextflow-os-haris.vercel.app
PUBLIC_URL=
